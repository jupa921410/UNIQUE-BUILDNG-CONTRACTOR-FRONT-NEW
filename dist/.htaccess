# Unique Building Contractors — SPA routing + prerendered portfolio pages
# (Apache / Hostinger shared hosting).
#
#  WARNING: this file is copied into dist/ by the build and will overwrite any
#  .htaccess already sitting in public_html on deploy. If you keep custom rules
#  there (forced HTTPS, www<->non-www redirect, extra security headers), MERGE
#  the mod_rewrite block below into that file instead of overwriting it.

Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^portfolio/dental-clinic-addition/?$ /portfolio/dental-clinic-addition-dunedin-fl [R=301,L]
  RewriteRule ^portfolio/bathroom-remodel/?$ /portfolio/bathroom-remodel-st-petersburg-fl [R=301,L]
  RewriteRule ^portfolio/remodeling-project/?$ /portfolio/remodeling-project-clearwater-beach-fl [R=301,L]
  RewriteRule ^portfolio/complete-bathroom-remodeling/?$ /portfolio/complete-bathroom-remodeling-zephyrhills-fl [R=301,L]

  # The home route is valid even before mod_dir resolves DirectoryIndex.
  RewriteRule ^$ /index.html [L]

  # Never touch the shell itself (prevents a rewrite loop).
  RewriteRule ^index\.html$ - [L]

  # 1. Real files are served untouched — hashed JS/CSS/images, robots.txt,
  #    sitemap.xml, the IndexNow key, portfolio-sitemap.php, and every
  #    generated /portfolio/**/index.html page.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Paths that have a prerendered index.html (/portfolio/, /portfolio/<slug>/)
  #    are served straight from that file — same result with or without the
  #    trailing slash and with no extra 301 redirect.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Only these private/transactional SPA routes may use the shell.
  RewriteRule ^(?:portal(?:/(?:login|forgot-password|invoices|reset-password/[^/]+|projects/[^/]+))?|thank-you)/?$ /index.html [L]

  # Preserve the legacy service URL as a permanent redirect.
  RewriteRule ^service/([a-z0-9-]+)/?$ /services/$1 [R=301,L]
  RewriteRule ^services/kitchensabdathrooms/?$ /services/kitchens-bathrooms [R=301,L]

  # Unknown URLs and missing assets return a real HTTP 404.
  RewriteRule ^ - [R=404,L]

  # 3. Everything else is a client-side route → hand over the SPA shell.

</IfModule>

# Serve the custom error document while preserving the HTTP 404 status.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Host-scoped: this rule cannot add noindex on www at production launch.
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} =~ m#(?i)^test\.[^:]+(?::[0-9]+)?$#"
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|png|jpe?g|gif|svg|webp|avif|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
