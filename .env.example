# Base URL of the Laravel backend (UNIQUE-BUILDING-CONTRACTORS-BACKEND).
# Used for the contact form, showcase/portfolio API and the Client Portal.
#
# You normally DON'T need this file — the committed .env.development and
# .env.production already point `npm run dev` and `npm run build` at the right
# backend. Create an untracked .env.local only to override locally (e.g. a
# backend on a non-default port):
#
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=https://admin.uniquebuildingcontractors.com
